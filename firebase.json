{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/autoreply",
        "function": "autoreply"
      },
      {
        "source": "/",
        "destination": "/home.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
