# WhatsApp Assistant Pro - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Required: Gemini API Configuration
# ============================================
# Your Google Gemini API key
# Get one from: https://makersuite.google.com/app/apikey
# Used by the backend for Gemini AI replies
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: If you prefer to use API_KEY instead
# API_KEY=your_gemini_api_key_here

# ============================================
# Optional: Server Configuration
# ============================================
# Port for the Express server (defaults to 3000 if not set)
PORT=3000

# Node environment (production, development, etc.)
NODE_ENV=production

# ============================================
# Optional: Firebase Admin SDK Configuration
# ============================================
# Path to Firebase service account key JSON file
# Only needed if you're not using serviceAccountKey.json in the project root
# The app will automatically look for serviceAccountKey.json in the project root first
# Format: Windows: C:\path\to\serviceAccountKey.json
#         Linux/Mac: /path/to/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# Notes:
# ============================================
# 1. The app has a hardcoded DEFAULT_API_KEY in index.js as a fallback
#    but it's recommended to use environment variables for security
# 2. For Firebase, you can either:
#    - Place serviceAccountKey.json in the project root (recommended)
#    - Set GOOGLE_APPLICATION_CREDENTIALS to the path of your service account key
#    - Use Application Default Credentials (if running on Google Cloud)
# 3. Make sure to add .env to .gitignore to keep your secrets safe!
